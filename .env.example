APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

XOR_KEY=

GIT_BRANCH_NAME=main
GIT_WEBHOOK_SECRET=
GIT_WEBHOOK_MIGRATE=false
GIT_WEBHOOK_MIGRATE_FORCE=false

ANDROID_BUILD_TYPE=release

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
